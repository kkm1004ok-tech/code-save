##데이터개요
import pandas as pd
import numpy as np

data = {
    'name': ['김민수', '이지영', '박준호', '최서연', '정도윤'],
    'age': [25, 30, 28, 22, 35],
    'city': ['서울', '부산', '인천', '서울', '대전'],
    'score': [90, 85, 95, 80, np.nan]
}
df = pd.DataFrame(data)

  # 데이터 측정
print(df.describe())
  # 모든 데이터 타입 측정
df.describe(include='all')
  # 수치형 데이터 측정
df.describe(include=[np.number])
  # 범주형 데이터 측정
df.describe(include=['object'])
  # 특정 열 분석
df['score'].describe()


##데이터 열선택 및 조작
