               sep=',',header=0,index_col=None,
               skiprows=None,nrows=None)

with open('data.json',mode='r',encoding='utf-8') as f:
  data=json.load(f)
print(data)

df=pd.read_json('data.json',orient='records',encoding='utf-8')

